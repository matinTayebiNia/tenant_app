{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "7.0.2",
        "hekmatinasser/verta": "^8.4",
        "james-heinrich/getid3": "^1.9",
        "jenssegers/agent": "^2.6",
        "kasraghoreyshi/persian-faker": "^1.04",
        "laravel/framework": "^11.9",
        "laravel/octane": "^2.9",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.1",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.29",
        "league/flysystem-ftp": "^3.0",
        "nevadskiy/laravel-tree": "^0.5.1",
        "pishran/laravel-persian-slug": "^2.2",
        "pishran/laravel-persian-string": "^1.6",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-backup": "^8.8",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-sluggable": "^3.6",
        "spatie/laravel-translatable": "^6.7",
        "spatie/simple-excel": "^3.7",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^3.5",
        "spiral/roadrunner-worker": "^3.6",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.1",
        "laravel/pint": "^1.21",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/ModuleHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
